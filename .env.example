# ScreenMate configuration. Copy this file to `.env` and fill in your values.
# Nothing here is committed: `.env` is gitignored.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_TOKEN=
# Space/comma separated list of Telegram user ids allowed to use the bot.
ALLOWED_USERS=

# ---------------------------------------------------------------------------
# Ollama (LLM)
# ---------------------------------------------------------------------------
# Use host.docker.internal to reach a service on the host from the container.
OLLAMA_URL=http://localhost:11434
# Small 3B model that stays responsive on CPU-only machines and handles the
# bot's multilingual chat + JSON intent well. Pull it first with
# `ollama pull qwen2.5:3b-instruct-q4_K_M`. Use a bigger model (e.g.
# qwen2.5:7b-instruct-q4_K_M) only if you have a GPU. Other good CPU options:
# gemma2:2b (faster, smaller), phi3.5, llama3.2.
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# Keep the model loaded in RAM between messages ("30m", "24h", or "-1" forever).
OLLAMA_KEEP_ALIVE=30m
# Seconds to wait for a full generation (CPU inference can be slow).
OLLAMA_TIMEOUT=300
# Seconds to wait just to connect to Ollama (fail fast if it's down).
OLLAMA_CONNECT_TIMEOUT=10
# Max tokens generated for intent JSON / chat replies.
OLLAMA_NUM_PREDICT_INTENT=100
OLLAMA_NUM_PREDICT_CHAT=400
# How many times to retry a transient connection failure.
OLLAMA_RETRIES=2

# ---------------------------------------------------------------------------
# Jackett (torrent search)
# ---------------------------------------------------------------------------
JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=
# Seconds to wait for a search. Jackett queries every indexer and waits for the
# slowest, so keep this generous. Trim your indexer list in Jackett if searches
# are consistently slow.
JACKETT_TIMEOUT=90
# Seconds to wait just to connect to Jackett (fail fast if it's down).
JACKETT_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Jellyfin (library refresh)
# ---------------------------------------------------------------------------
JELLYFIN_URL=http://localhost:8096
# Create one in Dashboard > API Keys.
JELLYFIN_API_KEY=

# ---------------------------------------------------------------------------
# qBittorrent (download client)
# ---------------------------------------------------------------------------
QBIT_URL=http://localhost:8081
QBIT_USERNAME=
QBIT_PASSWORD=
# Where qBittorrent drops finished files (paths as seen by qBittorrent).
QBIT_MOVIES_PATH=/media/movies
QBIT_TV_PATH=/media/tv
QBIT_MOVIES_CATEGORY=movies
QBIT_TV_CATEGORY=tv

# ---------------------------------------------------------------------------
# Host media libraries (bind-mounted into the container by docker-compose)
# ---------------------------------------------------------------------------
MOVIES_HOST_PATH=./media/movies
TV_HOST_PATH=./media/tv
